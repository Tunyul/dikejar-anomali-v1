; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Anomaly Rush!"
config/version="1.3.31-beta"
run/main_scene="res://scenes/LoadingScreen.tscn"
config/features=PackedStringArray("4.6")
config/icon="uid://cs8vxi0qroewf"

[autoload]

TransitionManager="*res://scenes/TransitionManager.tscn"
Preloader="*res://scripts/Preloader.gd"
RemoteContent="*res://scripts/RemoteContent.gd"
MissionsManager="*res://scripts/MissionsManager.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/size/resizable=false
window/size/window_width_override=1024
window/size/window_height_override=576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

